#!/bin/bash

# LoveLion Integration Test
# Runs: go fmt → unit tests → integration tests (self-cleaning) → E2E tests

set -e

echo "🧪 Starting integration test..."
echo ""

# Step 1: go fmt
echo "📝 Running go fmt..."
docker compose exec backend gofmt -w .
echo "✅ go fmt complete"
echo ""

# Step 2: go test (unit tests)
echo "🧪 Running backend unit tests..."
docker compose exec backend go test ./...
echo "✅ Backend unit tests passed"
echo ""

# Step 3: npm test (frontend unit tests)
echo "🧪 Running frontend unit tests..."
docker compose exec frontend npm test
echo "✅ Frontend unit tests passed"
echo ""

# Step 4: Integration tests (TestMain truncates all tables before running)
echo "🧪 Running integration tests..."
docker compose exec backend go test -v -tags integration -count=1 ./integration/...
echo "✅ All integration tests passed"

# Step 5: Promote dev to admin + investment owner
echo ""
echo "👑 Promoting dev user to admin..."
docker compose exec postgres psql -U postgres -d lovelion -c "UPDATE users SET role = 'admin' WHERE username = 'dev';"
echo "📈 Adding dev as investment owner..."
docker compose exec backend go run cmd/inv-init/main.go dev

# Step 6: E2E tests (Playwright)
echo ""
echo "🎭 Running E2E tests..."
docker compose up -d backend
echo "⏳ Waiting for backend to be ready..."
until docker compose exec -T backend wget -q --spider http://localhost:8080/api/announcements 2>/dev/null; do sleep 2; done
docker compose run --rm playwright sh -c "npm install --prefer-offline --silent 2>/dev/null && npx playwright test --reporter=list"
echo "✅ All E2E tests passed"

echo ""
echo "🎉 All tests passed!"
echo ""
echo "📝 Test account:"
echo "   Username: dev"
echo "   Password: dev123"
